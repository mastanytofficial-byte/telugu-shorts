+// LLMs can accidentally mix English words into Tenglish. Validate the
+// on-screen text and the Telugu-script voice before rendering anything.
+const FORBIDDEN_ENGLISH_WORDS = new Set([
+  'a', 'an', 'and', 'are', 'best', 'beautiful', 'because', 'be', 'but',
+  'deep', 'distance', 'feeling', 'feelings', 'first', 'forever', 'happy',
+  'heart', 'heartbeat', 'life', 'line', 'love', 'memories', 'memory',
+  'miss', 'missing', 'my', 'relationship', 'sad', 'special', 'story',
+  'true', 'waiting', 'you', 'your', 'is', 'was', 'were', 'the', 'to',
+  'of', 'in', 'on', 'for', 'with', 'from', 'this', 'that', 'me', 'mine',
+  'someone', 'one', 'side', 'long', 'old', 'night', 'rain', 'after',
+  'sorry', 'firstlove', 'lifeline'
+]);
+
+function findForbiddenEnglishWords(text) {
+  const words = String(text || '').toLowerCase().match(/[a-z]+(?:'[a-z]+)?/g) || [];
+  return [...new Set(words.filter(word => FORBIDDEN_ENGLISH_WORDS.has(word)))];
+}
+
+function validateRomanticQuote(screenText, voiceScript, target) {
+  const screen = String(screenText || '').trim();
+  const voice = String(voiceScript || '').trim();
+  const wordCount = screen.split(/\s+/).filter(Boolean).length;
+  const problems = [];
+  const forbidden = findForbiddenEnglishWords(screen);
+
+  if (wordCount < target.min || wordCount > target.max) {
+    problems.push(`SCREEN has ${wordCount} words; required ${target.min}-${target.max}`);
+  }
+  if (forbidden.length) {
+    problems.push(`SCREEN contains English words: ${forbidden.join(', ')}`);
+  }
+  if (/[A-Za-z]/.test(voice)) {
+    problems.push('VOICE contains Latin/English letters; Telugu script only is allowed');
+  }
+  if (/#\S+/.test(screen) || /#\S+/.test(voice)) {
+    problems.push('Hashtags are not allowed');
+  }
+
+  return { valid: problems.length === 0, problems, wordCount };
+}
 
